# Functional fixes are independent of diagnostic source instrumentation.
set(_backport_dir "${PROJECT_BINARY_DIR}/network_backports")
set(_backport_flags)
if(CONFIG_CLIP_NETWORK_BACKPORT_DHCP)
    list(APPEND _backport_flags --dhcp)
endif()
if(CONFIG_CLIP_NETWORK_BACKPORT_ARP AND NOT CONFIG_CLIP_WIFI_DIAG)
    list(APPEND _backport_flags --arp)
endif()
execute_process(COMMAND "${PYTHON_EXECUTABLE}"
    "${CMAKE_CURRENT_SOURCE_DIR}/../../tools/https_poc/backport_network.py"
    --zephyr "${ZEPHYR_BASE}" --output "${_backport_dir}" ${_backport_flags}
    RESULT_VARIABLE _backport_result)
if(NOT _backport_result EQUAL 0)
    message(FATAL_ERROR "Pinned SDK network fixes could not be generated")
endif()

function(clip_backport_source target relative)
    get_target_property(originals ${target} SOURCES)
    get_target_property(base ${target} SOURCE_DIR)
    get_filename_component(filename "${relative}" NAME)
    set(updated)
    set(found 0)
    foreach(source IN LISTS originals)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${base}")
        if(absolute STREQUAL "${ZEPHYR_BASE}/${relative}")
            list(APPEND updated "${_backport_dir}/${filename}")
            math(EXPR found "${found}+1")
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "SDK network source target changed: ${target}:${relative}")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${updated}")
    get_filename_component(parent "${ZEPHYR_BASE}/${relative}" DIRECTORY)
    target_include_directories(${target} PRIVATE "${parent}")
endfunction()

if(CONFIG_CLIP_NETWORK_BACKPORT_DHCP)
    clip_backport_source(subsys__net__lib__dhcpv4 subsys/net/lib/dhcpv4/dhcpv4.c)
endif()
if(CONFIG_CLIP_NETWORK_BACKPORT_ARP AND NOT CONFIG_CLIP_WIFI_DIAG)
    clip_backport_source(subsys__net__l2__ethernet subsys/net/l2/ethernet/arp.c)
endif()
